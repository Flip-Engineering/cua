# The gVisor source of Flip's runsc build. One place: a rebuild changes nothing
# unless this file or drivers.json changes. Sourced by bash; KEY=value only.

# gVisor's release tag and the commit it names.
GVISOR_RELEASE=release-20261123.0
GVISOR_RELEASE_COMMIT=6abe42f82cb9fadf431d622741ac8bd9f3e75ab1
# The commit of gVisor's `go` branch that merges GVISOR_RELEASE_COMMIT (its
# second parent): the same source with the generated Go files a plain
# `go build` needs. build.sh checks that parent.
GVISOR_GO_COMMIT=83df8eae069e6c607672f779f63f3538815cc037
# Our build's number for this gVisor release; every binary of the build carries
# the label <GVISOR_RELEASE>-flip.<FLIP_RUNSC_BUILD>.
FLIP_RUNSC_BUILD=1
# The Go release of GVISOR_GO_COMMIT's go.mod (`go` line); build.sh checks it.
GO_VERSION=1.27.3
